[configuration]
entry_symbol            = "libprge_rt"
compatibility_minimum   = "4.4"
reloadable              = true

# [icons]
# CCoreGameManager     = "assets/icons/nodes/CCoreGameManager.svg"

[libraries]
linux.debug.x86_64      = "bin/linux/debug/libprge.so"
linux.release.x86_64    = "bin/linux/release/libprge.so"
windows.debug.x86_64    = "bin/windows/debug/libprge.dll"
windows.release.x86_64  = "bin/windows/release/libprge.dll"
# macos.debug             = "bin/macos/debug/libprge.framework"       # NOT SUPPORTED
# macos.release           = "bin/macos/release/libprge.framework"     # NOT SUPPORTED
# android.debug.arm64     = "bin/anroid/debug/libprge.so"             # NOT SUPPORTED
# android.release.arm64   = "bin/anroid/release/libprge.so"           # NOT SUPPORTED
# android.debug.x86_64    = "bin/anroid/debug/libprge.so"             # NOT SUPPORTED
# android.release.x86_64  = "bin/anroid/release/libprge.so"           # NOT SUPPORTED
# ios.debug.arm64         = "bin/ios/debug.libprge.dylib"             # NOT SUPPORTED
# ios.release.arm64       = "bin/ios/release/libprge.dylib"           # NOT SUPPORTED
# ios.debug.x86_64        = "bin/ios/debug/libprge.dylib"             # NOT SUPPORTED
# ios.release.x86_64      = "bin/ios/release/libprge.dylib"           # NOT SUPPORTED
# html.debug              = "bin/wasm/debug/libprge.wasm"             # NOT SUPPORTED
# html.release            = "bin/wasm/release/libprge.wasm"           # NOT SUPPORTED

# [dependencies]
# linux.debug.x86_64     = { "bin/linux/debug/libsteam_api.so": "" }
# linux.release.x86_64   = { "bin/linux/release/libsteam_api.so": "" }
# windows.debug.x86_64   = { "bin/windows/debug/steam_api64.dll": "" }
# windows.release.x86_64 = { "bin/windows/release/steam_api64.dll": "" }
# macos.debug            = { "bin/macos/debug/libsteam_api.dylib": "" }
# macos.release          = { "bin/macos/release/libsteam_api.dylib": "" }
