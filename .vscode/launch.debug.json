{
    "configurations":
    [
        {
            "name": "EDITOR: libprge",
            "type": "cppvsdbg", // windows=cppvsdbg else=cppdbg
            "request": "launch",
            "cwd": "${fileDirname}",
            "program": "/path/to/godot_editor_launcher",
            "stopAtEntry": false,
            "args": [
                "-e", "--path", "${workspaceFolder}/example"
            ],
            "environment": []
        },
        {
            "name": "LAUNCHER: libprge",
            "type": "cppvsdbg", // windows=cppvsdbg else=cppdbg
            "request": "launch",
            "cwd": "${fileDirname}",
            "program": "/path/to/godot_template_build",
            "stopAtEntry": false,
            "args": [
                "-e", "--path", "${workspaceFolder}/example"
            ],
            "environment": []
        }
    ]
}
