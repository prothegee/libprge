{
    "configurations":
    [
        {
            "name": "EDITOR: libprge apporgame/example",
            "type": "cppvsdbg", // windows=cppvsdbg else=cppdbg
            "request": "launch",
            "cwd": "${fileDirname}",
            "program": "path/to/godot_executeable",
            "stopAtEntry": false,
            "args": [
                "-e", "--path", "${workspaceFolder}/apporgame"
            ],
            "environment": []
        }
    ]
}
