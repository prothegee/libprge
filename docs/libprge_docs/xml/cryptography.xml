    <methods>
        <method name="sha1">
			<description>
				generate sha1 from input param
                return length is 40
			</description>
			<param index="0" name="input" type="String" />
			<return type="String" />
		</method>

        <!-- ////////////////////////////////////////////////////// -->

        <method name="sha224">
			<description>
				generate sha224 from input param
                return length is 56
			</description>
			<param index="0" name="input" type="String" />
			<return type="String" />
		</method>

        <!-- ////////////////////////////////////////////////////// -->

        <method name="sha256">
			<description>
				generate sha256 from input param
                return length is 64
			</description>
			<param index="0" name="input" type="String" />
			<return type="String" />
		</method>

        <!-- ////////////////////////////////////////////////////// -->

        <method name="sha384">
			<description>
				generate sha384 from input param
                return length is 96
			</description>
			<param index="0" name="input" type="String" />
			<return type="String" />
		</method>

        <!-- ////////////////////////////////////////////////////// -->

        <method name="sha512">
			<description>
				generate sha512 from input param
                return length is 128
			</description>
			<param index="0" name="input" type="String" />
			<return type="String" />
		</method>

        <!-- ////////////////////////////////////////////////////// -->

        <method name="scrypt">
			<description>
				scrypt password hasher using cryptopp
                you may adjust computationCost, blockSizeCost, threadsCost, & derivedLength as you need
			</description>
			<param index="0" name="input" type="String" />
			<param index="1" name="salt" type="String" />
			<param index="2" name="computationCost" type="ui64" />
			<param index="3" name="blockSizeCost" type="ui64" />
			<param index="4" name="threadsCost" type="ui64" />
			<param index="5" name="derivedLength" type="ui32" />
			<return type="String" />
		</method>

        <!-- ////////////////////////////////////////////////////// -->

        <method name="aesEncrypt">
			<description>
				encrypt input using CBC AES Rijndael stream cipher
                iv recomendation length is 16
                ik recomendation length is 16 to 32
			</description>
			<param index="0" name="input" type="String" />
			<param index="1" name="iv" type="String" />
			<param index="2" name="ik" type="String" />
			<return type="String" />
		</method>

        <method name="aesDecrypt">
			<description>
				decrypt input using CBC AES Rijndael stream cipher
                iv recomendation length is 16
                ik recomendation length is 16 to 32
			</description>
			<param index="0" name="input" type="String" />
			<param index="1" name="iv" type="String" />
			<param index="2" name="ik" type="String" />
			<return type="String" />

        <!-- ////////////////////////////////////////////////////// -->

        <method name="xChaCha20encrypt">
			<description>
				encrypt input using XChaCha20 stream cipher
                iv recomendation length is 16 to 24
                ik recomendation length is 32
			</description>
			<param index="0" name="input" type="String" />
			<param index="1" name="iv" type="String" />
			<param index="2" name="ik" type="String" />
			<return type="String" />
		</method>

        <method name="xChaCha20decrypt">
			<description>
				decrypt input using XChaCha20 stream cipher
                iv recomendation length is 16 to 24
                ik recomendation length is 32
			</description>
			<param index="0" name="input" type="String" />
			<param index="1" name="iv" type="String" />
			<param index="2" name="ik" type="String" />
			<return type="String" />

        <!-- ////////////////////////////////////////////////////// -->

        <method name="rc6encrypt">
			<description>
				encrypt input using CBC R6 stream cipher
                iv recomendation length is 16
                ik recomendation length is 16 to 32
			</description>
			<param index="0" name="input" type="String" />
			<param index="1" name="iv" type="String" />
			<param index="2" name="ik" type="String" />
			<return type="String" />
		</method>

        <method name="rc6decrypt">
			<description>
				decrypt input using CBC R6 stream cipher
                iv recomendation length is 16
                ik recomendation length is 16 to 32
			</description>
			<param index="0" name="input" type="String" />
			<param index="1" name="iv" type="String" />
			<param index="2" name="ik" type="String" />
			<return type="String" />
		</method>
