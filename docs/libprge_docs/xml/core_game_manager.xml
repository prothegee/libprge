<?xml version="1.0" encoding="UTF-8" ?>
<class
name="CCoreGameManager"
inherits="Node"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd"
>
	<brief_description>
        libprge core game manager
	</brief_description>
	<description>
        core game manager
		user for managing game project externally
        there should be only one of this node under "/root" node
	</description>
	<tutorials>
	</tutorials>
	<constants>
        <constant name="GAME_DISTRIBUTION_TARGET_UNDEFINED" value="i32" enum="EGameDistributionTarget">
			game distribution target is undefined
		</constant>
        <constant name="GAME_DISTRIBUTION_TARGET_DESKTOP" value="i32" enum="EGameDistributionTarget">
			game distribution target is desktop kind
		</constant>
        <constant name="GAME_DISTRIBUTION_TARGET_MOBILE" value="i32" enum="EGameDistributionTarget">
			game distribution target is mobile kind
		</constant>
        <constant name="GAME_DISTRIBUTION_TARGET_CONSOLE" value="i32" enum="EGameDistributionTarget">
			game distribution target is console kind
		</constant>
        <constant name="GAME_DISTRIBUTION_TARGET_WEB" value="i32" enum="EGameDistributionTarget">
			game distribution target is web kind
		</constant>
	</constants>
	<members>
        <member name="m_gameLongName" type="String" setter="setGameLongName" getter="getGameLongName">
			private: game long name
		</member>

        <!-- ////////////////////////////////////////////////////// -->

        <member name="m_gameShortName" type="String" setter="setGameShortName" getter="getGameShortName">
			private: game short name
		</member>

        <!-- ////////////////////////////////////////////////////// -->

        <member name="m_versionMajor" type="i32" setter="setVersionMajor" getter="getVersionMajor">
			private: version major
		</member>

        <member name="m_versionMinor" type="i32" setter="setVersionMinor" getter="getVersionMinor">
			private: version minor
		</member>

        <member name="m_versionPatch" type="i32" setter="setVersionPatch" getter="getVersionPatch">
			private: version patch
		</member>

        <member name="m_versionDates" type="i32" setter="setVersionDates" getter="getVersionDates">
			private: version dates
		</member>

        <!-- ////////////////////////////////////////////////////// -->

        <member name="m_distributionTarget" type="EGameDistributionTarget" setter="setDistributionTarget" getter="getDistributionTarget">
			private: distribution target e.g. Desktop, Mobile, & etc.
		</member>

        <member name="m_distributionStore" type="String" setter="setDistributionStore" getter="getDistributionStore">
			private: distribution store, e.g. Steam, itch.io, GoG, or custom
		</member>
	</members>
    <methods>
        <method name="setGameLongName">
			<description>
				set game long name
			</description>
			<param index="0" name="gameLongName" type="String" />
			<return type="void" />
		</method>
        <method name="getGameLongName">
			<description>
				get game long name
			</description>
			<return type="String" />
		</method>

        <!-- ////////////////////////////////////////////////////// -->

        <method name="setGameShortName">
			<description>
				set game short name
			</description>
			<param index="0" name="gameShortName" type="String" />
			<return type="void" />
		</method>
        <method name="getGameShortName">
			<description>
				get game short name
			</description>
			<return type="String" />
		</method>

        <!-- ////////////////////////////////////////////////////// -->

        <method name="setVersionMajor">
			<description>
				set version major
			</description>
			<param index="0" name="versionMajor" type="i32" />
			<return type="void" />
		</method>
        <method name="getVersionMajor">
			<description>
				get version major
			</description>
			<return type="i32" />
        </method>

        <!-- ////////////////////////////////////////////////////// -->

        <method name="setVersionMinor">
			<description>
				set version minor
			</description>
			<param index="0" name="versionMinor" type="i32" />
			<return type="void" />
		</method>
        <method name="getVersionMinor">
			<description>
				get version minor
			</description>
			<return type="i32" />
        </method>

        <!-- ////////////////////////////////////////////////////// -->

        <method name="setVersionPatch">
			<description>
				set version patch
			</description>
			<param index="0" name="versionPatch" type="i32" />
			<return type="void" />
		</method>
        <method name="getVersionPatch">
			<description>
				get version patch
			</description>
			<return type="i32" />
        </method>

        <!-- ////////////////////////////////////////////////////// -->

        <method name="setVersionDates">
			<description>
				set version dates
			</description>
			<param index="0" name="versionDates" type="i32" />
			<return type="void" />
		</method>
        <method name="getVersionDates">
			<description>
				get version dates
			</description>
			<return type="i32" />
        </method>

        <!-- ////////////////////////////////////////////////////// -->

        <method name="getVersionFullString">
			<description>
				get version full string i.e. MAJOR.MINOR.PATCH.YYYYMMDD
			</description>
			<return type="String" />
        </method>

        <!-- ////////////////////////////////////////////////////// -->

        <method name="setDistributionTarget">
			<description>
				set distribution target
			</description>
			<param index="0" name="distributionTarget" type="EGameDistributionTarget" />
			<return type="void" />
        </method>
        <method name="getDistributionTarget">
			<description>
				get distribution target
			</description>
			<return type="EGameDistributionTarget" />
        </method>

        <!-- ////////////////////////////////////////////////////// -->

        <method name="setDistributionStore">
			<description>
				set distribution store
			</description>
			<param index="0" name="distributionStore" type="String" />
			<return type="void" />
        </method>
        <method name="getDistributionStore">
			<description>
				get distribution store
			</description>
			<return type="String" />
        </method>

        <!-- ////////////////////////////////////////////////////// -->

        <method name="getDistributionSystem">
			<description>
				get distribution system, i.e. Windows, Linux Debian, etc.
			</description>
			<return type="String" />
        </method>

        <!-- ////////////////////////////////////////////////////// -->

        <method name="isCCoreGameManager">
			<description>
				tell if this is CCoreGameManager class
			</description>
			<return type="bool" />
        </method>
	</methods>
	<signals>
	</signals>
</class>
