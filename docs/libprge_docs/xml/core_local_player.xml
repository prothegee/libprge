<?xml version="1.0" encoding="UTF-8" ?>
<class
name="CCoreLocalPlayer"
inherits="Node"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd"
>
	<brief_description>
        libprge core local player
	</brief_description>
	<description>
        core local player
		user for game local player
        there should be only one of this node under "/root" node
	</description>
	<tutorials>
	</tutorials>
	<constants>
        <constant name="CORE_LOCAL_PLAYER_STATE_UNDEFINED" value="i32" enum="ECoreLocalPlayerState">
			current state is undefined
		</constant>
        <constant name="CORE_LOCAL_PLAYER_STATE_LOADING" value="i32" enum="ECoreLocalPlayerState">
			current state is in loading
		</constant>
        <constant name="CORE_LOCAL_PLAYER_STATE_IN_MENU" value="i32" enum="ECoreLocalPlayerState">
			current state is in menu
		</constant>
        <constant name="CORE_LOCAL_PLAYER_STATE_IN_GAMEPLAY" value="i32" enum="ECoreLocalPlayerState">
			current state is in gameplay
		</constant>
        <constant name="CORE_LOCAL_PLAYER_STATE_IN_GAMEPLAY_MENU" value="i32" enum="ECoreLocalPlayerState">
			current state is in gameplay menu
		</constant>
        <constant name="CORE_LOCAL_PLAYER_STATE_IN_GAMEPLAY_INTERACTION" value="i32" enum="ECoreLocalPlayerState">
			current state is in gameplay interaction
		</constant>
        <constant name="CORE_LOCAL_PLAYER_STATE_IN_SOMEWHERE_SINCE_NOT_SURE" value="i32" enum="ECoreLocalPlayerState">
			current state is in somewhere, since you & I not sure
		</constant>
	</constants>
	<members>
        <member name="m_playerId" type="ui64" setter="setPlayerId" getter="getPlayerId">
			public: player unsigned int id
		</member>

        <!-- ////////////////////////////////////////////////////// -->

        <member name="m_playerIdString" type="String" setter="setPlayerIdString" getter="getPlayerIdString">
			public: player string id
		</member>

        <!-- ////////////////////////////////////////////////////// -->

        <member name="m_stateType" type="ECoreLocalPlayerState" setter="setStateType" getter="getStateType">
			public: player state type
		</member>
	</members>
    <methods>
        <method name="setPlayerId">
			<description>
				set player id
			</description>
			<param index="0" name="playerId" type="ui64" />
			<return type="void" />
		</method>
        <method name="getPlayerId">
			<description>
				get player id
			</description>
			<return type="ui64" />
		</method>

        <!-- ////////////////////////////////////////////////////// -->

        <method name="setPlayerIdString">
			<description>
				set player id string
			</description>
			<param index="0" name="playerIdString" type="String" />
			<return type="void" />
		</method>
        <method name="getPlayerIdString">
			<description>
				get player id string
			</description>
			<return type="String" />
		</method>

        <!-- ////////////////////////////////////////////////////// -->

        <method name="setStateType">
			<description>
				set state type
			</description>
			<param index="0" name="stateType" type="ECoreLocalPlayerState" />
			<return type="void" />
		</method>
        <method name="getStateType">
			<description>
				get state type
			</description>
			<return type="ECoreLocalPlayerState" />
		</method>

        <!-- ////////////////////////////////////////////////////// -->

        <method name="isCCoreLocalPlayer">
			<description>
				tell if this is CCoreLocalPlayer class
			</description>
			<return type="bool" />
		</method>
	</methods>
	<signals>
        <signal name="stateType_changed">
			<description>
				emit when m_stateType changed
			</description>
		</signal>
	</signals>
</class>
